        "def token_to_patch_xy(token_id: int, num_patches: int, patch_size: int):\n",
        "    if token_id <= 0:\n",
        "        return None\n",
        "    idx = token_id - 1\n",
        "    col = idx % num_patches\n",
        "    row = idx // num_patches\n",
        "    return (col * patch_size, row * patch_size)\n"
      ]
    },
