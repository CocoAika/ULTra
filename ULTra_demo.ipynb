      "source": [
        "# --- Example: explain a single token ---\n",
        "layer = 13       # visual transformer block index\n",
        "token_id = 15    # 1..(7*7)=49 for ViT-B/32 patch tokens\n",
        "\n",
        "patch_size = model.visual.conv1.stride[0]\n",
        "num_patches = model.visual.input_resolution // patch_size\n",
        "patch_xy = token_to_patch_xy(token_id, num_patches=num_patches, patch_size=patch_size)\n",
        "\n",
        "R_image, _ =  interpret_token(img, layer, token_id, model, device,func=torch.sum)\n",
        "R_image[:, token_id - 1] = 0\n",
        "R_image[:, token_id - 1] = torch.max(R_image, axis=1)[0]\n",
        "R_image = R_image.reshape(-1, 7, 7).unsqueeze(1)\n",
        "\n",
        "fig, ax = plt.subplots(1, 1, figsize=(4, 4))\n",
        "image_relevance_on_ax(ax, R_image, img, layer=layer, token_index=token_id, patch_pos=patch_xy, patch_size=patch_size)\n",
        "plt.show()\n"
      ]
    },
