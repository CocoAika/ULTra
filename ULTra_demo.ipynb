      "source": [
        "## Unsupervised Segmentation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 125,
      "id": "QY9qK6FO2JYM",
      "metadata": {
        "id": "QY9qK6FO2JYM"
